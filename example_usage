def example_incident_response():
    """Example: Create and handle incidents"""
    from advanced_malware_system import IncidentResponseManager, ThreatLevel
    
    incident_mgr = IncidentResponseManager()
    
    # Create an incident
    incident = incident_mgr.create_incident(
        incident_type='ransomware_detected',
        description='WannaCry-like behavior detected on workstation-5',
        severity=ThreatLevel.CRITICAL
    )
    
    print(f"Incident Created: #{incident['id']}")
    print(f"Type: {incident['type']}")
    print(f"Severity: {incident['severity']}")
    print(f"Status: {incident['status']}")
    
    # Get response steps
    steps = incident_mgr.get_response_steps('ransomware_detected')
    
    print(f"\nResponse Playbook ({len(steps)} steps):")
    for i, step in enumerate(steps, 1):
        print(f"  {i}. {step}")


# ============================================================================
# EXAMPLE 6: Endpoint Protection
# ============================================================================

def example_endpoint_protection():
    """Example: Manage protected endpoints"""
    from advanced_malware_system import EndpointProtectionModule, ThreatLevel
    
    protection = EndpointProtectionModule()
    
    # Register endpoints
    endpoints = ['WORKSTATION-1', 'WORKSTATION-2', 'SERVER-PROD']
    for endpoint in endpoints:
        protection.register_endpoint(f"EP_{endpoint}", endpoint)
        print(f"Registered: {endpoint}")
    
    # Whitelist trusted processes
    trusted_processes = [
        'explorer.exe',
        'svchost.exe',
        'lsass.exe',
        'winlogon.exe',
        'chrome.exe',
        'firefox.exe',
    ]
    
    for process in trusted_processes:
        protection.add_to_whitelist(process)
        print(f"Whitelisted: {process}")
    
    # Blacklist known malicious processes
    malicious_processes = [
        'conficker.exe',
        'stuxnet.exe',
        'wannacry.exe',
        'mimikatz.exe',
    ]
    
    for process in malicious_processes:
        protection.add_to_blacklist(process)
        print(f"Blacklisted: {process}")
    
    # Check processes
    test_processes = ['explorer.exe', 'stuxnet.exe', 'unknown.exe']
    print("\nProcess Checks:")
    for process in test_processes:
        is_safe, severity = protection.check_process(process)
        print(f"  {process}: Safe={is_safe}, Severity={severity}")


# ============================================================================
# EXAMPLE 7: Complete Monitoring Workflow
# ============================================================================

def example_complete_workflow():
    """Example: Complete monitoring and response workflow"""
    from malware_prevention_system import (
        FileMonitor, NetworkMonitor, MalwareDatabase
    )
    from advanced_malware_system import (
        BehavioralAnalyzer, IncidentResponseManager
    )
    
    # Initialize all components
    print("Initializing Malware Prevention System...")
    
    db = MalwareDatabase()
    file_monitor = FileMonitor(db)
    net_monitor = NetworkMonitor(db)
    behavioral = BehavioralAnalyzer()
    incidents = IncidentResponseManager()
    
    # Step 1: Add threat intelligence
    print("\n1. Loading threat intelligence...")
    db.add_malicious_ip("192.168.100.50")
    db.add_blocked_domain("botnet.cc")
    db.add_threat_signature(r'.*ransom.*')
    print("   ✓ Threat database updated")
    
    # Step 2: Configure monitoring
    print("\n2. Configuring monitoring...")
    file_monitor.add_monitored_path("C:\\Users\\admin\\Documents")
    print("   ✓ File monitoring configured")
    
    # Step 3: Scan for threats
    print("\n3. Scanning for threats...")
    alerts = file_monitor.scan_directory("C:\\Users\\admin\\Documents")
    print(f"   ✓ Found {len(alerts)} potential threats")
    
    # Step 4: Check network connections
    print("\n4. Monitoring network...")
    is_allowed, reason = net_monitor.check_connection(
        "192.168.100.50", "botnet.cc", 443
    )
    print(f"   ✓ Connection blocked: {reason}")
    
    # Step 5: Behavioral analysis
    print("\n5. Analyzing behavior...")
    is_suspicious, severity = behavioral.analyze('file_enumeration', 150, 60)
    print(f"   ✓ Suspicious behavior detected: {severity}")
    
    # Step 6: Create incident
    print("\n6. Creating incident response...")
    incident = incidents.create_incident(
        'malware_spread',
        'Suspicious file enumeration detected',
        severity
    )
    print(f"   ✓ Incident #{incident['id']} created")
    
    # Step 7: Get response plan
    print("\n7. Retrieving response plan...")
    steps = incidents.get_response_steps('malware_spread')
    print(f"   ✓ Response plan has {len(steps)} steps")
    
    print("\n" + "="*50)
    print("Workflow complete - System secured")
    print("="*50)


