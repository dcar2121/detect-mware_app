def example_behavioral_analysis():
    """Example: Detect suspicious behavior patterns"""
    from advanced_malware_system import BehavioralAnalyzer, ThreatLevel
    
    analyzer = BehavioralAnalyzer()
    
    # Simulate suspicious behaviors
    behaviors = [
        ('file_enumeration', 150, 60),      # 150 files in 60 seconds - CRITICAL
        ('registry_modification', 45, 60),  # 45 registry mods in 60 seconds - MEDIUM
        ('process_injection', 2, 30),       # 2 injections in 30 seconds - LOW
        ('network_scan', 25, 60),           # 25 ports in 60 seconds - HIGH
    ]
    
    for behavior_type, count, timeframe in behaviors:
        is_suspicious, severity = analyzer.analyze(behavior_type, count, timeframe)
        print(f"{behavior_type}: {count} events in {timeframe}s")
        print(f"  → Suspicious: {is_suspicious}, Severity: {severity}\n")


