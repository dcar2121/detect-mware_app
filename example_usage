# ============================================================================
# EXAMPLE 1: Basic File Monitoring Usage
# ============================================================================

def example_file_monitoring():
    """Example: Monitor a directory for suspicious files"""
    from malware_prevention_system import FileMonitor, MalwareDatabase
    
    # Initialize
    db = MalwareDatabase()
    monitor = FileMonitor(db)
    
    # Add paths to monitor
    monitor.add_monitored_path("C:\\Users\\admin\\Desktop")
    monitor.add_monitored_path("C:\\Users\\admin\\Documents")
    
    # Scan specific file
    alerts = monitor.scan_file("C:\\Users\\admin\\Desktop\\suspicious.exe")
    
    # Process alerts
    for alert in alerts:
        print(f"Alert: {alert['type']}")
        print(f"  File: {alert['file']}")
        print(f"  Severity: {alert['severity']}")
        print(f"  Time: {alert['time']}")
    
    # Scan entire directory
    all_alerts = monitor.scan_directory("C:\\Users\\admin\\Downloads")
    print(f"Found {len(all_alerts)} potential threats")


# ============================================================================
# EXAMPLE 2: Network Monitoring Usage
# ============================================================================

def example_network_monitoring():
    """Example: Monitor network connections"""
    from malware_prevention_system import NetworkMonitor, MalwareDatabase
    
    # Initialize
    db = MalwareDatabase()
    net_monitor = NetworkMonitor(db)
    
    # Add malicious IPs and domains to block
    db.add_malicious_ip("192.168.1.100")
    db.add_blocked_domain("malware.com")
    
    # Check a connection
    ip = "192.168.1.100"
    domain = "malware.com"
    port = 443
    
    is_allowed, reason = net_monitor.check_connection(ip, domain, port)
    print(f"Connection {ip}:{port} - Allowed: {is_allowed}, Reason: {reason}")
    
    # Log connection
    net_monitor.log_connection(ip, domain, port, not is_allowed, reason)
    
    # Get statistics
    stats = net_monitor.get_network_stats()
    print(f"Network Stats: {stats}")


# ============================================================================
# EXAMPLE 3: Threat Signature Management
# ============================================================================

def example_threat_signatures():
    """Example: Work with threat signatures"""
    from malware_prevention_system import MalwareDatabase
    
    db = MalwareDatabase()
    
    # Add custom threat signatures (regex patterns)
    suspicious_patterns = [
        r'.*HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows\\CurrentVersion\\Run.*',
        r'.*powershell.*-enc.*',
        r'.*cmd\.exe.*\/c.*taskkill.*',
        r'.*WriteProcessMemory.*',
        r'.*CreateRemoteThread.*',
    ]
    
    for pattern in suspicious_patterns:
        db.add_threat_signature(pattern)
        print(f"Added signature: {pattern}")
    
    # View signatures
    print(f"\nTotal signatures: {len(db.signatures['trojan_patterns'])}")
    
    # Block infrastructure
    db.add_malicious_ip("10.0.0.50")
    db.add_blocked_domain("c2server.net")
    
    print(f"Blocked IPs: {len(db.signatures['known_malicious_ips'])}")
    print(f"Blocked Domains: {len(db.signatures['blocked_domains'])}")


