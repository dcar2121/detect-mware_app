def example_logging_reporting():
    """Example: Logging and generating reports"""
    import json
    from datetime import datetime
    
    # Sample log data
    logs = {
        'timestamp': datetime.now().isoformat(),
        'events': [
            {
                'type': 'FILE_ALERT',
                'file': 'C:\\Temp\\suspicious.exe',
                'severity': 'HIGH',
                'action': 'QUARANTINED'
            },
            {
                'type': 'NETWORK_ALERT',
                'ip': '192.168.1.100',
                'domain': 'malware.com',
                'action': 'BLOCKED'
            },
            {
                'type': 'BEHAVIOR_ALERT',
                'behavior': 'file_enumeration',
                'severity': 'CRITICAL',
                'action': 'INCIDENT_CREATED'
            }
        ],
        'statistics': {
            'total_alerts': 3,
            'critical': 1,
            'high': 1,
            'medium': 1,
            'threats_blocked': 5,
            'infections_prevented': 2
        }
    }
    
    # Export logs
    with open('security_report.json', 'w') as f:
        json.dump(logs, f, indent=2)
    
    # Generate text report
    report = f"""
╔════════════════════════════════════════════════════════╗
║           SECURITY MONITORING REPORT                   ║
╚════════════════════════════════════════════════════════╝

Report Generated: {logs['timestamp']}

SUMMARY:
  Total Alerts: {logs['statistics']['total_alerts']}
  Critical: {logs['statistics']['critical']}
  High: {logs['statistics']['high']}
  Medium: {logs['statistics']['medium']}
  
  Threats Blocked: {logs['statistics']['threats_blocked']}
  Infections Prevented: {logs['statistics']['infections_prevented']}

EVENTS:
"""
    
    for i, event in enumerate(logs['events'], 1):
        report += f"\n  {i}. {event['type']}\n"
        report += f"     Severity: {event.get('severity', 'N/A')}\n"
        report += f"     Action: {event['action']}\n"
    
    print(report)
    
    # Save report
    with open('security_report.txt', 'w') as f:
        f.write(report)
    
    print("\nReports saved:")
    print("  - security_report.json")
    print("  - security_report.txt")


